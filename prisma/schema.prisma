}

model Course {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  tagline     String            @default("")
  description String            @default("")
  version     String            @default("1.0.0")
  status      String            @default("PUBLISHED")
  sortOrder   Int               @default(0)
  languageId  String
  language    LearningLanguage  @relation(fields: [languageId], references: [id])
  levels      LearningLevel[]
  modules     CurriculumModule[]
  enrollments Enrollment[]

  @@index([languageId])
}

model CurriculumModule {
  id          String @id @default(cuid())
  courseId    String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code        String @unique
  title       String
  description String @default("")
  sortOrder   Int    @default(0)
  units       Unit[]
}

model LearningLevel {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code        String  @unique
  name        String
  cefrLabel   String  @default("")
  tagline     String  @default("")
  description String  @default("")
  sortOrder   Int     @default(0)
  status      String  @default("AVAILABLE")
  units       Unit[]
  lessons     Lesson[]
}

model Unit {
  id          String             @id @default(cuid())
  slug        String             @unique
  levelId     String
  level       LearningLevel      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  moduleId    String?
  module      CurriculumModule?  @relation(fields: [moduleId], references: [id])
  code        String             @default("")
  title       String             @default("")
  description String             @default("")
  sortOrder   Int                @default(0)
  lessons     Lesson[]
}

model Lesson {
  id             String        @id @default(cuid())
  slug           String        @unique
  unitId         String
  unit           Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  levelId        String
  level          LearningLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  title          String
  subtitle       String?
  description    String        @default("")
  minutes        Int           @default(10)
  status         String        @default("PUBLISHED")
  contentVersion String        @default("1.0.0")
  isStructured   Boolean       @default(false)
  skillsJson     String        @default("[]")
  sortOrder      Int           @default(0)

  sections         LessonSection[]
  objectives       LessonObjective[]
  vocab            Vocabulary[]
  dialogue         Dialogue?
  passage          ReadingPassage?
  exampleSentences ExampleSentence[]
  exercises        Exercise[]
  assignments      Assignment[]
  audioAssets      AudioAsset[]
  grammarTopics    LessonGrammarTopic[]
  assessments      Assessment[]
  prerequisites    LessonPrerequisite[] @relation("LessonPrerequisites")
  prerequisiteFor  LessonPrerequisite[] @relation("LessonPrerequisiteFor")

  @@index([unitId])
  @@index([levelId])
}

model LessonSection {
  id          String @id @default(cuid())
  lessonId    String
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type        String
  title       String @default("")
  contentJson String @default("{}")
  sortOrder   Int    @default(0)

  @@unique([lessonId, type])
}

model LearningObjective {
  id      String            @id @default(cuid())
  code    String            @unique
