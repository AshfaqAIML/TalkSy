  overallScore     Float?
  summary          String            @default("")
  strengthsJson    String            @default("[]")
  improvementsJson String            @default("[]")
  checksJson       String            @default("[]")
  createdAt        DateTime          @default(now())
}

model SpeakingSubmission {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String?
  lessonSlug   String?
  promptText   String            @default("")
  expectedText String            @default("")
  transcript   String?
  durationMs   Int?
  createdAt    DateTime          @default(now())
  feedback     SpeakingFeedback?

  @@index([userId])
}

model SpeakingFeedback {
  id              String             @id @default(cuid())
  submissionId    String             @unique
  submission      SpeakingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  similarityScore Float?
  wordMatchRatio  Float?
  summary         String             @default("")
  tipsJson        String             @default("[]")
  createdAt       DateTime           @default(now())
}

/* ---------- Site ---------- */

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String   @default("general")
  message   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String
  entityType   String?
  entityId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}
