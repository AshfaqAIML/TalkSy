# Editor-agnostic formatting baseline for TalkSy.
# Matches the project style: 2-space indent, LF endings, trailing newline.
# Formatting detail beyond this baseline is documented in
# docs/DEVELOPMENT_GUIDELINES.md (Prettier-compatible defaults).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
